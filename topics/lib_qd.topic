                                              fetch-depth: 0  # a full history is required for pull request analysis
                                        - name: 'Qodana Scan'
                                          uses: %action-version%
                                          with:
                                              args: |
                                                  --linter %qd-linter-combined%
                                                  --within-docker false
                                          env:
                                              QODANA_TOKEN: ${{ secrets.QODANA_TOKEN }}
                        </code-block>
                    <code-block lang="yaml" filter="jvm">
